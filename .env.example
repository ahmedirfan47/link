# Copy to apps/web/.env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables. Never commit real keys.

# --- Supabase (database, sign-in, file storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Supabase → Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Grok by xAI (cues, Ask, rehearsal checks, live drafted answers, summaries) ---
# console.x.ai → API Keys. Server only.
XAI_API_KEY=xai-...
LINK_MODEL_PACK=grok-4.7
LINK_MODEL_LIVE=grok-4.7

# --- Live transcription for the desktop app ---
ASSEMBLYAI_API_KEY=...

# --- Optional: fallback for pages that cannot be fetched directly ---
FIRECRAWL_API_KEY=fc-...

# --- Product analytics and error reports (public project key) ---
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# --- Public site details ---
NEXT_PUBLIC_LINK_CONTACT_EMAIL=you@yourdomain.com
# Public GitHub repo that holds the Windows installer releases.
NEXT_PUBLIC_LINK_RELEASES_REPO=ahmedirfan47/link-releases

# --- Optional: change a daily cap per user (defaults in apps/web/src/lib/usage.ts) ---
# LINK_CAP_PACK_GENERATIONS=10