# Copy this file to .env.local inside apps/web (and apps/desktop later) and fill in real values.
# Never commit real keys.

# --- Supabase (database, auth, storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# --- Claude API (pack generation + live fallback) ---
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
LINK_MODEL_PACK=claude-sonnet-5-5
LINK_MODEL_LIVE=claude-haiku-5-5

# --- Speech-to-text (Phase 2, desktop) ---
ASSEMBLYAI_API_KEY=YOUR_ASSEMBLYAI_KEY
SONIOX_API_KEY=YOUR_SONIOX_KEY

# --- Web research for prep (optional) ---
FIRECRAWL_API_KEY=YOUR_FIRECRAWL_KEY