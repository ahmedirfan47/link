{
  "name": "@link/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Link live assistant for Windows",
  "author": "Link",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --config electron-builder.yml --publish never",
    "release": "electron-vite build && electron-builder --win --config electron-builder.yml --publish always"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@link/core": "*",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.7"
  }
}