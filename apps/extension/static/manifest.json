{
  "manifest_version": 3,
  "name": "Link: call cues",
  "short_name": "Link",
  "version": "0.1.0",
  "description": "Your prepared answers in a side panel next to Google Meet. Reads Meet's captions in your browser; no audio leaves your computer.",
  "action": { "default_title": "Open Link" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://link-zeta-six.vercel.app/*", "https://meet.google.com/*"],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content-meet.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
